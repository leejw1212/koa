# ~/.hermes/.env 에 채울 비밀 값 목록 (실제 값은 커밋하지 않는다)
OPENAI_API_KEY=

# OpenSearch — 클러스터 밖에서 붙을 때: kubectl -n logging port-forward svc/opensearch 9200:9200
OPENSEARCH_URL=http://127.0.0.1:9200
# 보안 플러그인이 켜진 클러스터면 아래를 채우고 config.yaml 의 OPENSEARCH_NO_AUTH 를 지운다
# OPENSEARCH_USERNAME=hermes-readonly
# OPENSEARCH_PASSWORD=
